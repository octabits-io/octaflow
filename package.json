{
  "name": "octaflow",
  "version": "0.17.2",
  "description": "Durable DAG workflow engine: Zod-typed steps over Postgres + pg-boss, with an optional AI add-on (token/cost/quota). Layered single package.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ai": {
      "types": "./dist/ai/index.d.ts",
      "import": "./dist/ai/index.js",
      "default": "./dist/ai/index.js"
    },
    "./store-pg": {
      "types": "./dist/store-pg/index.d.ts",
      "import": "./dist/store-pg/index.js",
      "default": "./dist/store-pg/index.js"
    },
    "./dispatcher-pgboss": {
      "types": "./dist/dispatcher-pgboss/index.d.ts",
      "import": "./dist/dispatcher-pgboss/index.js",
      "default": "./dist/dispatcher-pgboss/index.js"
    }
  },
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "build": "tsdown",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "lint": "node scripts/check-boundaries.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsdown",
    "changeset": "changeset",
    "changeset:version": "GITHUB_TOKEN=$(passage show github/token) changeset version",
    "changeset:publish": "pnpm build && echo \"//registry.npmjs.org/:_authToken=$(passage show npm/token/octabits)\" > .npmrc && { changeset publish; s=$?; rm -f .npmrc; exit $s; }",
    "release": "bash scripts/release.sh"
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm commitlint --edit $1"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/octabits-io/octaflow.git"
  },
  "homepage": "https://octaflow.octabits.io/",
  "bugs": {
    "url": "https://github.com/octabits-io/octaflow/issues"
  },
  "keywords": [
    "workflow",
    "dag",
    "durable-execution",
    "orchestration",
    "ai",
    "llm",
    "pg-boss",
    "postgres",
    "zod"
  ],
  "peerDependencies": {
    "@ai-sdk/provider": "^4.0.0",
    "ai": "^7.0.0",
    "pg": "^8.0.0",
    "pg-boss": "^12.21.0",
    "typescript": "^5 || ^6 || ^7",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/provider": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "pg-boss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.9",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "ai": "^7.0.87",
    "pg": "^8.23.0",
    "pg-boss": "^12.29.0",
    "simple-git-hooks": "^2.14.0",
    "testcontainers": "^12.1.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "zod": "^4.5.4"
  }
}
